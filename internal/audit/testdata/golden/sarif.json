  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AISAI",
          "version": "golden",
          "informationUri": "https://github.com/tlmcguire/aisai",
          "rules": [
            {
              "id": "subprocess-shell-true",
              "name": "subprocess-shell-true",
              "shortDescription": {
                "text": "subprocess call with shell=True allows shell command injection"
              },
              "fullDescription": {
                "text": "Pass the command as a list of arguments and leave shell=False."
              },
              "helpUri": "https://github.com/tlmcguire/aisai",
              "properties": {
                "cwe": "CWE-78",
                "tags": [
                  "security"
                ],
                "tool": "aisai"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "pickle-yaml-unsafe-load",
              "name": "pickle-yaml-unsafe-load",
              "shortDescription": {
                "text": "unsafe YAML load without SafeLoader can construct arbitrary objects"
              },
              "fullDescription": {
                "text": "Use json, or yaml.safe_load / Loader=yaml.SafeLoader."
              },
              "helpUri": "https://github.com/tlmcguire/aisai",
              "properties": {
                "cwe": "CWE-502",
                "tags": [
                  "security"
                ],
                "tool": "aisai"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "weak-hash-md5-sha1",
              "name": "weak-hash-md5-sha1",
              "shortDescription": {
                "text": "weak hash algorithm hashlib.md5 is used where a strong algorithm is required"
              },
              "fullDescription": {
                "text": "Use hashlib.sha256 or hashlib.sha512."
              },
              "helpUri": "https://github.com/tlmcguire/aisai",
              "properties": {
                "cwe": "CWE-327",
                "tags": [
                  "security"
                ],
                "tool": "aisai"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "assert-used-for-validation",
              "name": "assert-used-for-validation",
              "shortDescription": {
                "text": "assert is used to validate request input and is removed under python -O"
              },
              "fullDescription": {
                "text": "Raise an explicit exception when the input is invalid."
              },
              "helpUri": "https://github.com/tlmcguire/aisai",
              "properties": {
                "cwe": "CWE-617",
                "tags": [
                  "security"
                ],
                "tool": "aisai"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
