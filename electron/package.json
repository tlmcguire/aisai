{
  "name": "aisai-electron",
  "version": "0.3.0",
  "private": true,
  "description": "AISAI Electron frontend (renderer + main/preload) for the Go AISAI backend.",
  "homepage": "https://github.com/tlmcguire/aisai",
  "repository": {
    "type": "git",
    "url": "https://github.com/tlmcguire/aisai.git"
  },
  "main": "dist/main/main.js",
  "author": {
    "name": "AISAI",
    "email": "109298992+tlmcguire@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"node scripts/dev.mjs\"",
    "postinstall": "node scripts/check-native-arch.mjs",
    "check:arch": "node scripts/check-native-arch.mjs",
    "dev:vite": "vite",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build && electron .",
    "package": "npm run build && node .github/run-builder.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:headed": "playwright test --config playwright.config.ts --headed",
    "dist:mac": "npm run build && node .github/run-builder.mjs --mac",
    "dist:win": "npm run build && node .github/run-builder.mjs --win",
    "dist:linux": "npm run build && node .github/run-builder.mjs --linux",
    "release:verify-env": "node .github/verify-release-env.mjs",
    "release:mac": "npm run build && node .github/run-builder.mjs --mac --release",
    "release:win": "npm run build && node .github/run-builder.mjs --win --release",
    "release:linux": "npm run build && node .github/run-builder.mjs --linux --release"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "dev.aisai.app",
    "productName": "AISAI",
    "copyright": "AISAI",
    "icon": "resources/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/main/aisai-server",
      "!dist/main/aisai-server.exe",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/sidecar",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": ".github/entitlements.mac.plist",
      "entitlementsInherit": ".github/entitlements.mac.plist"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development"
    },
    "forceCodeSigning": false,
    "beforeBuild": ".github/verify-release-env.mjs",
    "publish": [
      {
        "provider": "github",
        "owner": "tlmcguire",
        "repo": "aisai",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true
  }
}
